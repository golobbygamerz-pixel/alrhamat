function getErrorMessage(error: unknown): string {
  if (error instanceof Error) {
    return error.message;
  }
  if (
    typeof error === "object" &&
    error !== null &&
    "message" in error
  ) {
    return String(
      (error as { message?: unknown }).message ??
        "Something went wrong."
    );
  }
  return "Something went wrong.";
}
/* ============================================================
   CUSTOMER — ROOM AVAILABILITY
   ============================================================ */
export async function getRoomAvailability(
  search: BookingSearch
): Promise<RoomAvailability[]> {
  const { data, error } = await supabase.rpc(
    "get_room_availability",
    {
      p_check_in: search.checkIn,
      p_check_out: search.checkOut,
      p_adults: search.adults,
      p_children: search.children,
      p_rooms: search.rooms,
      p_bed_type: search.bedType || null
    }
  );
  if (error) {
    throw new Error(getErrorMessage(error));
  }
  return (data ?? []) as RoomAvailability[];
}
/* ============================================================
   CUSTOMER — CREATE REAL BOOKING
   ============================================================ */
export async function createBooking(
  input: CreateBookingInput
): Promise<CreatedBooking> {
  const { data, error } = await supabase.rpc(
    "create_booking",
    {
      p_room_id: input.roomId,
      p_guest_first_name: input.guestFirstName,
      p_guest_last_name: input.guestLastName,
      p_phone: input.phone,
      p_email: input.email,
      p_check_in: input.checkIn,
      p_check_out: input.checkOut,
      p_adults: input.adults,
      p_children: input.children,
      p_rooms_count: input.roomsCount,
      p_bed_type: input.bedType,
      p_special_request:
        input.specialRequest?.trim() || null
    }
  );
  if (error) {
    throw new Error(getErrorMessage(error));
  }
  const booking = Array.isArray(data)
    ? data[0]
    : data;
  if (!booking) {
    throw new Error(
      "Booking could not be created. Please try again."
    );
  }
  return {
    booking_id: String(booking.booking_id),
    booking_code: String(booking.booking_code),
    total_amount: Number(booking.total_amount),
    nights: Number(booking.nights)
  };
}
/* ============================================================
   CUSTOMER — FIND MY BOOKING
   Requires booking ID + phone number.
   ============================================================ */
export async function findBooking(
  bookingCode: string,
  phone: string
): Promise<Booking | null> {
  const { data, error } = await supabase.rpc(
    "find_booking",
    {
      p_booking_code: bookingCode.trim(),
      p_phone: phone.trim()
    }
  );
  if (error) {
    throw new Error(getErrorMessage(error));
  }
  const row = Array.isArray(data)
    ? data[0]
    : data;
  if (!row) {
    return null;
  }
  return {
    id: String(row.id),
    booking_code: String(row.booking_code),
    room_id: String(row.room_id),
    room: row.room_name
      ? {
          id: String(row.room_id),
          slug: "",
          name: String(row.room_name),
          description: "",
          price_per_night: Number(row.price_per_night),
          room_size: 0,
          max_guests: 0,
          bed_type: row.bed_type,
          total_units: 0,
          image_url: String(row.room_image_url ?? ""),
          gallery: [],
          amenities: []
        }
      : undefined,
    guest_first_name: String(row.guest_first_name),
    guest_last_name: String(row.guest_last_name),
    phone: String(row.phone),
    email: String(row.email),
    check_in: String(row.check_in),
    check_out: String(row.check_out),
    adults: Number(row.adults),
    children: Number(row.children),
    rooms_count: Number(row.rooms_count),
    bed_type: row.bed_type,
    special_request:
      row.special_request ?? undefined,
    nights: Number(row.nights),
    price_per_night: Number(row.price_per_night),
    total_amount: Number(row.total_amount),
    status: row.status,
    payment_status: row.payment_status,
    created_at: String(row.created_at)
  };
}
/* ============================================================
   CUSTOMER — GET ALL PUBLIC ROOMS
   ============================================================ */
export async function getRooms(): Promise<Room[]> {
  const { data, error } = await supabase
    .from("rooms")
    .select("*")
    .order("price_per_night", {
      ascending: true
    });
  if (error) {
    throw new Error(getErrorMessage(error));
  }
  return (data ?? []).map((room) => ({
    id: String(room.id),
    slug: String(room.slug),
    name: String(room.name),
    description: String(room.description),
    price_per_night: Number(
      room.price_per_night
    ),
    room_size: Number(room.room_size),
    max_guests: Number(room.max_guests),
    bed_type: room.bed_type,
    total_units: Number(room.total_units),
    image_url: String(room.image_url),
    gallery: Array.isArray(room.gallery)
      ? room.gallery.map(String)
      : [],
    amenities: Array.isArray(room.amenities)
      ? room.amenities.map(String)
      : [],
    created_at: room.created_at
      ? String(room.created_at)
      : undefined
  }));
}
/* ============================================================
   ADMIN — AUTH
   ============================================================ */
export async function adminLogin(
  email: string,
  password: string
) {
  const { data, error } =
    await supabase.auth.signInWithPassword({
      email: email.trim(),
      password
    });
  if (error) {
    throw new Error(getErrorMessage(error));
  }
  return data;
}
export async function adminLogout() {
  const { error } =
    await supabase.auth.signOut();
  if (error) {
    throw new Error(getErrorMessage(error));
  }
}
export async function getCurrentAdmin() {
  const {
    data: { user },
    error
  } = await supabase.auth.getUser();
  if (error) {
    throw new Error(getErrorMessage(error));
  }
  if (!user) {
    return null;
  }
  const { data: admin, error: adminError } =
    await supabase
      .from("admin_users")
      .select("user_id, email")
      .eq("user_id", user.id)
      .maybeSingle();
  if (adminError) {
    throw new Error(
      getErrorMessage(adminError)
    );
  }
  if (!admin) {
    return null;
  }
  return {
    id: user.id,
    email: String(
      admin.email ?? user.email ?? ""
    )
  };
}
